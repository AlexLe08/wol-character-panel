{
  // `npm run build`: one .js and one .d.ts per source file in dist/, ESM
  // only. tsc keeps each file's directives, so SlotHover.js still starts
  // with "use client"; a bundler would merge it into CharacterSheet.js.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
